// Release behavior shared by local and distribution signing.
ENABLE_DEBUG_DYLIB = NO
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
SWIFT_OPTIMIZATION_LEVEL = -O
// Embedded extensions are already signed; do not try to strip them while copying.
COPY_PHASE_STRIP = NO
// Remove debug maps during ordinary Release builds, before code signing.
DEPLOYMENT_POSTPROCESSING = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = debugging
ONLY_ACTIVE_ARCH = NO
